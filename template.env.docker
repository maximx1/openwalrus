# Settings for running with Docker Compose. Copy to .env and fill in the two required values:
#   cp template.env.docker .env
# See docs/deploy.md.

# REQUIRED. The address the app is opened at, exactly as it appears in a browser: scheme,
# host, and port if there is one, no trailing slash. Only requests for this host are
# answered, and with https:// the session cookie is sent over HTTPS only.
APP_URL=

# REQUIRED. Signs session cookies; anyone who knows it can sign in as any user. Changing it
# signs everyone out. Generate one with: openssl rand -hex 32
APP_SECRET=

# --- Optional -------------------------------------------------------------------------

# Set to false once everyone in your group has an account, so nobody else can make one.
#ALLOW_REGISTRATION=true

# The MongoDB to use. Leave unset for the one compose.yaml runs. For your own, remove the
# mongo service from compose.yaml and give its connection string here; the database is the
# part after the last /. See "Using your own MongoDB" in docs/deploy.md.
#MONGO_URI=mongodb://user:password@host.docker.internal:27017/openwalrus?authSource=admin

# The port on this machine that the app answers on.
#APP_PORT=9000

# Who can reach that port. The default is this machine only, for a reverse proxy on the
# same host. 0.0.0.0 exposes it to the network.
#APP_BIND=127.0.0.1

# Only for the bundled HTTPS proxy (docker compose --profile caddy): the domain, no https://
#APP_DOMAIN=
