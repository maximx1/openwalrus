# The JSON API. The web client (web/) is the only thing that calls it.
GET     /api/health                         controllers.ApiController.healthCheck
GET     /api/session                        controllers.ApiController.session
POST    /api/session                        controllers.ApiController.signIn
DELETE  /api/session                        controllers.ApiController.signOut

GET     /api/users                          controllers.ApiController.users
POST    /api/users                          controllers.ApiController.signUp
GET     /api/handles/:handle                controllers.ApiController.handleAvailability(handle: String)
GET     /api/users/:handle                  controllers.ApiController.user(handle: String)
GET     /api/users/:handle/grunts           controllers.ApiController.userGrunts(handle: String, before: Option[Long])
GET     /api/users/:handle/followers        controllers.ApiController.followers(handle: String)
GET     /api/users/:handle/following        controllers.ApiController.following(handle: String)
PUT     /api/users/:handle/follow           controllers.ApiController.follow(handle: String)
DELETE  /api/users/:handle/follow           controllers.ApiController.unfollow(handle: String)
PUT     /api/me/profile-image               controllers.ApiController.setProfileImage
PUT     /api/me/banner-image                controllers.ApiController.setBannerImage

GET     /api/feed                           controllers.ApiController.feed(before: Option[Long])
GET     /api/hot                            controllers.ApiController.hot
POST    /api/views                          controllers.ApiController.recordViews
POST    /api/grunts                         controllers.ApiController.postGrunt
DELETE  /api/grunts/:id                     controllers.ApiController.deleteGrunt(id: String)

POST    /api/images                         controllers.ApiController.uploadImage
GET     /api/images/:id                     controllers.ApiController.image(id: String)
GET     /api/images/:id/thumb               controllers.ApiController.imageThumb(id: String)

# The built web client: its hashed bundles, then everything else falls through to index.html.
GET     /assets/*file                       controllers.Assets.at(path="/public/assets", file)
GET     /                                   controllers.FrontendController.index
GET     /*path                              controllers.FrontendController.route(path)
